{
  "$description": "AURAMAXING design-kit — cinematic dark-first DTCG tokens. Retune per project. Values in OKLCH.",
  "color": {
    "bg":           { "$type": "color", "$value": "oklch(0.15 0.006 286)" },
    "bg-subtle":    { "$type": "color", "$value": "oklch(0.18 0.008 286)" },
    "surface":      { "$type": "color", "$value": "oklch(0.21 0.009 286)" },
    "surface-2":    { "$type": "color", "$value": "oklch(0.25 0.010 286)" },
    "border":       { "$type": "color", "$value": "oklch(0.30 0.010 286)" },
    "border-strong":{ "$type": "color", "$value": "oklch(0.40 0.012 286)" },
    "text":         { "$type": "color", "$value": "oklch(0.97 0.004 286)" },
    "text-muted":   { "$type": "color", "$value": "oklch(0.74 0.008 286)" },
    "text-subtle":  { "$type": "color", "$value": "oklch(0.58 0.009 286)" },
    "accent":       { "$type": "color", "$value": "oklch(0.88 0.21 125)" },
    "accent-hover": { "$type": "color", "$value": "oklch(0.83 0.21 125)" },
    "accent-contrast": { "$type": "color", "$value": "oklch(0.18 0.04 130)" },
    "danger":       { "$type": "color", "$value": "oklch(0.64 0.21 25)" },
    "success":      { "$type": "color", "$value": "oklch(0.74 0.17 150)" }
  },
  "font": {
    "display": { "$type": "fontFamily", "$value": "'Satoshi Variable', 'Geist Variable', system-ui, sans-serif" },
    "body":    { "$type": "fontFamily", "$value": "'Geist Variable', system-ui, sans-serif" },
    "mono":    { "$type": "fontFamily", "$value": "'Geist Mono Variable', 'Monaspace Neon', monospace" }
  },
  "fontSize": {
    "step--1": { "$type": "dimension", "$value": "clamp(0.83rem, 0.8rem + 0.15vw, 0.94rem)" },
    "step-0":  { "$type": "dimension", "$value": "clamp(1rem, 0.95rem + 0.25vw, 1.13rem)" },
    "step-1":  { "$type": "dimension", "$value": "clamp(1.2rem, 1.1rem + 0.5vw, 1.5rem)" },
    "step-2":  { "$type": "dimension", "$value": "clamp(1.44rem, 1.27rem + 0.85vw, 2rem)" },
    "step-3":  { "$type": "dimension", "$value": "clamp(1.73rem, 1.46rem + 1.36vw, 2.66rem)" },
    "step-4":  { "$type": "dimension", "$value": "clamp(2.07rem, 1.67rem + 2vw, 3.55rem)" },
    "step-5":  { "$type": "dimension", "$value": "clamp(2.49rem, 1.9rem + 2.95vw, 4.74rem)" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "0.375rem" },
    "md": { "$type": "dimension", "$value": "0.625rem" },
    "lg": { "$type": "dimension", "$value": "1rem" },
    "xl": { "$type": "dimension", "$value": "1.5rem" }
  },
  "duration": {
    "fast":   { "$type": "duration", "$value": "150ms" },
    "base":   { "$type": "duration", "$value": "250ms" },
    "slow":   { "$type": "duration", "$value": "450ms" }
  },
  "easing": {
    "out":    { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1] },
    "in-out": { "$type": "cubicBezier", "$value": [0.65, 0, 0.35, 1] },
    "spring": { "$type": "cubicBezier", "$value": [0.34, 1.56, 0.64, 1] }
  }
}
